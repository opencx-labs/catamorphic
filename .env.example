# Catamorphic is embed-only. These variables are consumed by the host app
# (e.g. OpenCX) when it boots catamorphic in-process via `@catamorphic/sdk`
# or mounts `@catamorphic/server` via `createApp({ core })`. Copy the values
# you need into the host's own `.env`.

# --- Database --------------------------------------------------------------
# Host Postgres connection string. Catamorphic tables live in their own schema
# (default `catamorphic`) so they can coexist with the host's schema in the
# same database.
DATABASE_URL=postgresql://catamorphic:catamorphic@localhost:5432/catamorphic
CATAMORPHIC_DB_SCHEMA=catamorphic

# --- Git working tree ------------------------------------------------------
# Filesystem paths for per-user git working copies + bare remotes.
CATAMORPHIC_PROJECTS_PATH=./data/repos
CATAMORPHIC_REMOTES_PATH=./data/remotes

# --- Sandbox provider selection -------------------------------------------
# Daytona is the default sandbox provider until further notice. If
# DAYTONA_API_KEY is set, the server always uses Daytona — even when the
# Cloudflare env vars below are also populated. The Cloudflare Bridge path
# is kept working but is only selected when DAYTONA_API_KEY is unset.
# See CLOUDFLARE.md for the full integration reference.

# Daytona — default provider.
# DAYTONA_API_KEY=

# Cloudflare — wired up but not selected unless DAYTONA_API_KEY is unset.
# URL of the deployed Bridge Worker. Local dev points at wrangler dev.
# CLOUDFLARE_SANDBOX_API_URL=http://localhost:8787
# Shared bearer token between Fastify and the Bridge Worker.
# Must equal the Worker's SANDBOX_API_KEY secret (or .dev.vars locally).
# CLOUDFLARE_SANDBOX_API_KEY=local-dev

# Required once the Artifacts storage backend lands (see CLOUDFLARE.md → TODO).
# Unused by the server today; the Bridge Worker is the only Cloudflare surface
# the server calls in the current implementation.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ARTIFACTS_NAMESPACE=catamorphic-dev

# --- Plugins ---------------------------------------------------------------
# Local plugin package directory (used by LocalPluginResolver)
# Example: /Users/you/workspace/host-app/packages
# CATAMORPHIC_LOCAL_PLUGINS_DIR=
