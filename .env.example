# Catamorphic is an embeddable framework. These variables are consumed by the
# host app when it boots catamorphic in-process via `@catamorphic/server-sdk`
# (and/or mounts `@catamorphic/fastify-plugin`). Copy the values you need into
# the host's own `.env`.

# --- Database --------------------------------------------------------------
# Host Postgres connection string. Catamorphic manages its own tables inside a
# dedicated schema (default `catamorphic`) so it never pollutes the host's
# tables. Hosts can alternatively pass an existing pg.Pool to
# `createCatamorphic({ database: { pool } })`.
DATABASE_URL=postgresql://catamorphic:catamorphic@localhost:5432/catamorphic
CATAMORPHIC_DB_SCHEMA=catamorphic
# Host port for the dev docker-compose Postgres (default 5432). Change it if
# another Postgres already occupies the port, and point DATABASE_URL (in the
# host app's .env) at the same port if you want to use this instance.
# CATAMORPHIC_POSTGRES_PORT=5432

# --- Project storage (git) --------------------------------------------------
# Filesystem paths for per-user git working copies + bare origin remotes.
# Remote-first alternatives: S3-compatible object storage (`S3RemoteBackend`
# from @catamorphic/s3, see docs/decisions/0012) or Cloudflare Artifacts
# (`ArtifactsRemoteBackend` from @catamorphic/cloudflare, docs/decisions/0004).
CATAMORPHIC_PROJECTS_PATH=./data/repos
CATAMORPHIC_REMOTES_PATH=./data/remotes

# S3-compatible origin storage (Cloudflare R2, AWS S3, MinIO). Used by
# @catamorphic/s3's S3ObjectStore + S3RemoteBackend; the host's boot code
# reads these (see apps/playground/src/server/boot.ts). Also enables the
# @catamorphic/s3 integration tests.
# For R2: S3_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com, region "auto".
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_KEY_PREFIX=playground/

# --- Sandbox backends -------------------------------------------------------
# Backends are vendor plugin packages: @catamorphic/cloudflare (default) or
# @catamorphic/daytona. The host constructs a provider explicitly at boot and
# passes it to `createCatamorphic({ sandboxProvider })` — these vars are read
# by the host's own boot code (see apps/playground/src/server/boot.ts and
# CLOUDFLARE.md).

# Cloudflare — default provider (CloudflareSandboxProvider).
# URL of the deployed Sandbox Bridge Worker. Local dev points at wrangler dev.
# CLOUDFLARE_SANDBOX_API_URL=http://localhost:8787
# Shared bearer token between the host server and the Bridge Worker.
# Must equal the Worker's SANDBOX_API_KEY secret (or .dev.vars locally).
# CLOUDFLARE_SANDBOX_API_KEY=local-dev

# Cloudflare Artifacts — code storage (ArtifactsClient + ArtifactsRemoteBackend).
# Requires the Artifacts closed beta on the account.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ARTIFACTS_NAMESPACE=catamorphic-dev

# Daytona — alternate provider (DaytonaSandboxProvider from
# @catamorphic/daytona). Also enables the Daytona integration tests.
# DAYTONA_API_KEY=

# --- Plugins ---------------------------------------------------------------
# Local plugin package directory (used by LocalPluginResolver)
# CATAMORPHIC_LOCAL_PLUGINS_DIR=/path/to/host/plugin/packages

# --- Observability ----------------------------------------------------------
# Catamorphic instruments itself with @opentelemetry/api only. The host owns
# the OpenTelemetry SDK (tracer provider, exporters, sampling); no env vars
# are needed here. Spans are no-ops until the host registers a provider.
