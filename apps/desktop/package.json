{
  "name": "catamorphic-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsgo --project ./tsconfig.json && tsgo --project ./tsconfig.node.json",
    "package": "electron-vite build && electron-builder",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:e2e": "electron-vite build && vitest run --config ./vitest.e2e.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/openai": "^4.0.17",
    "@catamorphic/ai-sdk": "workspace:*",
    "@catamorphic/api-client": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/fastify-plugin": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/github": "workspace:*",
    "@catamorphic/microsandbox": "workspace:*",
    "@catamorphic/react": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@catamorphic/server-sdk": "workspace:*",
    "@catamorphic/ui": "workspace:*",
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/cors": "^11.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.101.2",
    "fastify": "^5.10.0",
    "hash-wasm": "^4.12.0",
    "jotai": "^2",
    "kdbxweb": "^2.1.1",
    "kysely": "^0.29.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.1.4",
    "monaco-editor": "^0.55.1"
  }
}
