{
  "name": "catamorphic-desktop",
  "productName": "Work",
  "version": "0.1.0-alpha.38",
  "description": "A local-first workspace for projects, agents, workflows, and apps",
  "author": "The Catamorphic Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencx-labs/catamorphic.git",
    "directory": "apps/desktop"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE bun --bun electron-vite dev -- --remote-debugging-port=${CATAMORPHIC_DESKTOP_CDP_PORT:-9333}",
    "build": "bun --bun electron-vite build && bun scripts/verify-build.ts",
    "typecheck": "bun check --project ./tsconfig.json && bun check --project ./tsconfig.node.json",
    "package": "bun --bun run --cwd ../pwa build && bun --bun electron-vite build && bun scripts/verify-build.ts && bun --bun electron-builder --publish never",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd apps/desktop --config ../../vitest.config.ts --pool=forks",
    "test:e2e": "bun ../../scripts/desktop-test.ts",
    "test:eval": "bun ../../scripts/customization-eval.ts",
    "test:e2e:ci": "bun ../../scripts/desktop-test.ts --native"
  },
  "dependencies": {
