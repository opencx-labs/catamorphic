{
  "name": "catamorphic-desktop",
  "productName": "Catamorphic",
  "version": "0.1.0-alpha.1",
  "description": "A local-first workspace for projects, agents, workflows, and apps",
  "author": "The Catamorphic Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencx-labs/catamorphic.git",
    "directory": "apps/desktop"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE bun --bun electron-vite dev -- --remote-debugging-port=${CATAMORPHIC_DESKTOP_CDP_PORT:-9333}",
    "build": "bun --bun electron-vite build",
    "typecheck": "tsgo --project ./tsconfig.json && tsgo --project ./tsconfig.node.json",
    "package": "bun --bun run --cwd ../pwa build && bun --bun electron-vite build && bun --bun electron-builder --publish never",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd apps/desktop --config ../../vitest.config.ts",
    "test:e2e": "bun --bun electron-vite build && CATAMORPHIC_E2E_WINDOW_MODE=hidden bun ../../scripts/tool-runtime.ts vitest --tool-cwd apps/desktop --config ./vitest.e2e.config.ts",
    "test:e2e:visible": "bun --bun electron-vite build && CATAMORPHIC_E2E_WINDOW_MODE=visible bun ../../scripts/tool-runtime.ts vitest --tool-cwd apps/desktop --config ./vitest.e2e.config.ts",
    "test:eval": "bun --bun electron-vite build && CATAMORPHIC_E2E_WINDOW_MODE=hidden bun ../../scripts/tool-runtime.ts vitest --tool-cwd apps/desktop --config ./vitest.eval.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/openai": "^4.0.17",
    "@catamorphic/ai-sdk": "workspace:*",
    "@catamorphic/api-client": "workspace:*",
    "@catamorphic/claude-code": "workspace:*",
    "@catamorphic/codex": "workspace:*",
    "@catamorphic/core": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/fastify-plugin": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/github": "workspace:*",
    "@catamorphic/mcp": "workspace:*",
    "@catamorphic/microsandbox": "workspace:*",
    "@catamorphic/react": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@catamorphic/server-sdk": "workspace:*",
    "@catamorphic/ui": "workspace:*",
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/cors": "^11.3.0",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-bubble-menu": "3.30.1",
    "@tiptap/extension-code-block-lowlight": "3.30.1",
    "@tiptap/extension-drag-handle": "3.30.1",
    "@tiptap/extension-node-range": "3.30.1",
    "@tiptap/extension-table": "3.30.1",
    "@tiptap/extension-task-item": "3.30.1",
    "@tiptap/extension-task-list": "3.30.1",
    "@tiptap/markdown": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "fastify": "^5.10.0",
    "ghostty-web": "0.4.0-next.20.g1858a59",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11",
    "jotai": "^2",
    "kdbxweb": "^2.1.1",
    "kysely": "^0.29.3",
    "lowlight": "3.3.0",
    "lucide-react": "^1.25.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.2.2",
    "monaco-editor": "^0.56.0"
  }
}
