"\nimport { useState } from \"react\";\nimport { ReviewShell, ReviewFinding, DiffView, type ReviewView } from \"./components/catamorphic/code-review.js\";\nexport default function App() {\n  const [view, setView] = useState<ReviewView>(\"guide\");\n  const [layout, setLayout] = useState<\"split\" | \"unified\">(\"unified\");\n  const [wrap, setWrap] = useState(false);\n  return <ReviewShell title=\"Validate input before processing\" subtitle=\"Pull request 7 \u00b7 Captured review\" value={view} onChange={setView}\n    overview={<p>This change rejects empty input. Caller behavior is not included in the captured patch.</p>}\n    guide={<div className=\"cat-review-prose\"><h2>Validate input</h2><p>The input guard changes from unconditional acceptance to checking input length.</p><ReviewFinding title=\"Check the boundary\" source={{ file: \"src/guard.ts\", line: 2, side: \"additions\", revision: \"fixture-head\" }} onOpenSource={() => setView(\"diff\")}><p>Verify which input types reach this boundary. The supplied patch does not include caller evidence.</p></ReviewFinding></div>}\n    changes={<DiffView path=\"src/guard.ts\" before={\"export function accept(input: string) {\\n  return true;\\n}\\n\"} after={\"export function accept(input: string) {\\n  return input.length > 0;\\n}\\n\"} layout={layout} wrap={wrap} onLayoutChange={setLayout} onWrapChange={setWrap} />}\n    discussion={<p>No discussion was captured in this review.</p>} />;\n}\n"
