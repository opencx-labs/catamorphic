# Playground-local overrides. The dev scripts also load the repo root `.env`
# (Cloudflare + Daytona keys); values here win.

# Postgres for catamorphic state (schema-scoped to `catamorphic`).
DATABASE_URL=postgresql://catamorphic:catamorphic@localhost:5433/catamorphic

# Port for the playground API server (Vite proxies /api here).
PLAYGROUND_SERVER_PORT=8500

# Cloudflare Sandbox bridge (start with `bun run dev` in
# packages/cloudflare-sandbox-bridge for local dev).
# CLOUDFLARE_SANDBOX_API_URL=http://localhost:8787
# CLOUDFLARE_SANDBOX_API_KEY=local-dev

# Cloudflare Artifacts (code storage). Requires closed-beta access.
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ARTIFACTS_NAMESPACE=catamorphic-dev
