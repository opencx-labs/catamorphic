# Playground-local overrides. The dev scripts also load the repo root `.env`
# (Cloudflare + Daytona keys); values here win.

# Postgres for catamorphic state (schema-scoped to `catamorphic`).
DATABASE_URL=postgresql://catamorphic:catamorphic@localhost:5433/catamorphic

# Port for the playground API server (Vite proxies /api here).
PLAYGROUND_SERVER_PORT=8500

# Cloudflare Sandbox bridge (start with `bun run dev` in
# packages/cloudflare-sandbox-bridge for local dev).
# CLOUDFLARE_SANDBOX_API_URL=http://localhost:8787
# CLOUDFLARE_SANDBOX_API_KEY=local-dev

# In-process AI SDK coding agent. Supported prefixes in the reference host are
# openai/ and anthropic/. If omitted, the host picks a default for an available
# provider key.
# CODING_AGENT_MODEL=openai/gpt-5.2-codex
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# S3-compatible code storage (Cloudflare R2 et al.) — the default origin
# backend when set (docs/decisions/0012). For R2 use
# S3_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com and an R2 API token
# with Object Read & Write on the bucket.
# S3_ENDPOINT=...
# S3_BUCKET=...
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto
# S3_KEY_PREFIX=playground/

# Cloudflare Artifacts (code storage). Requires closed-beta access; used only
# when the S3_* vars above are not set.
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ARTIFACTS_NAMESPACE=catamorphic-dev

# OpenTelemetry traces (OTLP/HTTP). Defaults to the dev collector from the
# repo-root docker-compose (`docker compose up -d clickhouse otel-collector`),
# which stores spans in ClickHouse (HTTP UI on localhost:8124).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true
