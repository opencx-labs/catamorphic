{
  "name": "catamorphic-playground",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --env-file=../../.env --env-file=.env --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsgo --project ./tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@catamorphic/api-client": "workspace:*",
    "@catamorphic/cloudflare": "workspace:*",
    "@catamorphic/fastify-plugin": "workspace:*",
    "@catamorphic/flue": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/react": "workspace:*",
    "@catamorphic/s3": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@catamorphic/server-sdk": "workspace:*",
    "@catamorphic/ui": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tanstack/react-query": "^5",
    "fastify": "^5.7.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "monaco-editor": "^0.55.1",
    "vite": "^7.3.4"
  }
}
