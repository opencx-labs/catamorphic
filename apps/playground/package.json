{
  "name": "catamorphic-playground",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --env-file=../../.env --env-file=.env --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsgo --project ./tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/openai": "^4.0.17",
    "@catamorphic/ai-sdk": "workspace:*",
    "@catamorphic/api-client": "workspace:*",
    "@catamorphic/cloudflare": "workspace:*",
    "@catamorphic/fastify-plugin": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/react": "workspace:*",
    "@catamorphic/s3": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@catamorphic/server-sdk": "workspace:*",
    "@catamorphic/ui": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tanstack/react-query": "^5.101.2",
    "fastify": "^5.10.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "concurrently": "^10.0.3",
    "monaco-editor": "^0.55.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.1.4"
  }
}
