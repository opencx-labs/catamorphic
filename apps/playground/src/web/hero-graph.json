  "sourceCode": "/** @displayname Create the account */\nasync function createUser({ email, name }: { email: string; name: string }) {\n  \"use step\";\n}\n\n/** @displayname Send a welcome email */\nasync function sendWelcomeEmail({ to }: { to: string }) {\n  \"use step\";\n}\n\n/** @displayname Unlock premium benefits */\nasync function assignPremiumBenefits({ userId }: { userId: string }) {\n  \"use step\";\n}\n\n/**\n * @displayname Welcome New User\n * @description Onboard a new user\n */\nexport async function welcomeUser({ email, name }: { email: string; name: string }) {\n  \"use workflow\";\n\n  const user = await createUser({ email, name });\n  await sendWelcomeEmail({ to: user.email });\n\n  if (user.plan === \"premium\") {\n    await assignPremiumBenefits({ userId: user.id });\n  }\n\n  return { status: \"complete\", userId: user.id };\n}"
