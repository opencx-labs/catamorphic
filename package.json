{
  "name": "catamorphic",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "docker compose up -d --wait && turbo dev --filter=@catamorphic/cloudflare-sandbox-bridge",
    "dev:desktop": "turbo run dev --no-daemon --concurrency=64 --filter=catamorphic-desktop...",
    "dev:companion": "turbo run dev --no-daemon --concurrency=64 --filter=catamorphic-companion...",
    "dev:server": "turbo run dev --no-daemon --concurrency=64 --filter=catamorphic-server...",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "bun run --filter @catamorphic/db db:migrate",
    "db:status": "bun run --filter @catamorphic/db db:status",
    "db:codegen": "bun run --filter @catamorphic/db db:codegen",
    "db:reset": "bun run --filter @catamorphic/db db:reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "tsup": "^8.5.1",
    "turbo": "2.10.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.1"
  }
}
