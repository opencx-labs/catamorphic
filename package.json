{
  "name": "catamorphic",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "docker compose up -d --wait && turbo dev --filter=catamorphic-playground --filter=@catamorphic/cloudflare-sandbox-bridge",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "bun run --filter @catamorphic/db db:migrate",
    "db:status": "bun run --filter @catamorphic/db db:status",
    "db:codegen": "bun run --filter @catamorphic/db db:codegen",
    "db:reset": "bun run --filter @catamorphic/db db:reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "tsup": "^8.5.1",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
