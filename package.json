{
  "name": "catamorphic",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "electron",
    "node"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts all",
    "dev:desktop": "bun scripts/dev.ts desktop",
    "dev:infra": "docker compose up -d --wait && bun scripts/tool-runtime.ts turbo dev --filter=@catamorphic/cloudflare-sandbox-bridge",
    "dev:pwa": "turbo run dev --no-daemon --concurrency=64 --filter=catamorphic-pwa...",
    "dev:server": "bun scripts/dev.ts server",
    "build": "turbo build",
    "test": "bun scripts/test.ts",
    "test:workspace": "node node_modules/turbo/bin/turbo run test --no-daemon --concurrency=4",
    "test:external": "CATAMORPHIC_EXTERNAL_INTEGRATIONS=1 bun scripts/tool-runtime.ts turbo run test --no-daemon --concurrency=4 --filter=@catamorphic/daytona --filter=@catamorphic/s3 --filter=@catamorphic/cloudflare",
    "test:file": "bun scripts/tool-runtime.ts vitest",
    "check": "bun scripts/check.ts",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "bun run --filter @catamorphic/db db:migrate",
    "db:status": "bun run --filter @catamorphic/db db:status",
    "db:codegen": "bun run --filter @catamorphic/db db:codegen",
    "db:reset": "bun run --filter @catamorphic/db db:reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "node": "24.13.0",
    "tsup": "^8.5.1",
    "turbo": "2.10.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.1",
    "rolldown": "1.2.5"
  }
}
