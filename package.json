{
  "name": "catamorphic",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts all",
    "dev:desktop": "bun scripts/dev.ts desktop",
    "dev:infra": "docker compose up -d --wait && bun scripts/tool-runtime.ts turbo dev --filter=@catamorphic/cloudflare-sandbox-bridge",
    "dev:pwa": "turbo run dev --no-daemon --concurrency=64 --filter=catamorphic-pwa...",
    "dev:server": "bun scripts/dev.ts server",
    "build": "turbo build",
    "test": "bun scripts/test.ts",
    "test:scripts": "bun scripts/tool-runtime.ts vitest --config ./vitest.config.ts --dir ./scripts",
    "test:workspace": "bun scripts/tool-runtime.ts turbo run test --no-daemon --force --concurrency=2",
    "test:external": "CATAMORPHIC_EXTERNAL_INTEGRATIONS=1 bun scripts/tool-runtime.ts turbo run test --no-daemon --force --concurrency=2 --filter=@catamorphic/s3 --filter=@catamorphic/cloudflare --filter=@catamorphic/codex --filter=@catamorphic/acp",
    "test:file": "bun scripts/tool-runtime.ts vitest",
    "eval:customization": "bun scripts/customization-eval.ts",
    "check": "bun scripts/check.ts",
    "typecheck:scripts": "tsc --noEmit --project ./tsconfig.scripts.json",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "bun run --filter @catamorphic/db db:migrate",
    "db:status": "bun run --filter @catamorphic/db db:status",
    "db:codegen": "bun run --filter @catamorphic/db db:codegen",
    "db:reset": "bun run --filter @catamorphic/db db:reset",
    "release:version": "bun scripts/release-packages.ts version",
    "release:verify": "bun scripts/release-packages.ts verify",
    "release:pack": "bun scripts/release-packages.ts pack",
    "release:smoke": "bun scripts/release-packages.ts smoke",
    "release:trust": "bun scripts/release-packages.ts trust",
    "postinstall": "bun scripts/tool-runtime.ts install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "turbo": "2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "npm": "12.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "dompurify": "^3.4.17",
    "js-yaml": "^4.3.2",
    "micromatch": "file:./vendor/micromatch",
    "sprintf-js": "file:./vendor/sprintf-js",
    "@hono/node-server@^2": "2.1.7",
    "body-parser@^2": "2.4.0",
    "fast-uri@^3": "3.1.9",
    "fast-uri@^4": "4.2.3",
    "glob@>=9 <15": "14.0.5",
    "minimatch@>=7 <11": "11.0.8",
    "node-forge": "1.4.3",
    "qs@^6": "6.17.1",
    "undici@^6": "6.29.1",
    "undici@^7": "7.30.2",
    "openapi-typescript>typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "zod@3.25.76": "patches/zod@3.25.76.patch",
    "npm@12.2.2": "patches/npm@12.2.2.patch"
  }
}
