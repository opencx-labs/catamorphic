{
  "name": "@catamorphic/ai-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/ai-sdk --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "@catamorphic/sandbox": "workspace:*",
    "ai": "^7.0.97",
    "zod": "^4.1.8",
    "@catamorphic/mcp": "workspace:*",
    "@catamorphic/otel": "workspace:*",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0"
  }
}
