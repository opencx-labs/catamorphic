{
  "name": "@catamorphic/ai-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "@catamorphic/sandbox": "workspace:*",
    "ai": "^7.0.34",
    "zod": "^4.1.8",
    "@catamorphic/mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
