{
  "name": "@catamorphic/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly && cp src/schema.d.ts dist/schema.d.ts",
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts"
    ]
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "5"
  }
}
