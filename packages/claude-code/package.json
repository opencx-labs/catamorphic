{
  "name": "@catamorphic/claude-code",
  "version": "0.1.0-alpha.30",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.build.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "record:claude-replay": "bun scripts/record-replay.ts && biome format --write src/testing/fixtures",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/claude-code --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/testing/index.ts"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@catamorphic/agent-protocol": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@catamorphic/agent-runner": "workspace:*",
    "@types/node": "^26.1.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/claude-code"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
