{
  "name": "@catamorphic/claude-code",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.221",
    "@catamorphic/sandbox": "workspace:*",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@catamorphic/core": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@types/node": "^26.1.1",
    "kysely": "^0.29.5"
  }
}
