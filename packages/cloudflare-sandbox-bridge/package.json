{
  "name": "@catamorphic/cloudflare-sandbox-bridge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that exposes Cloudflare Sandbox as an HTTP API consumed by the Fastify server.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "typecheck": "tsgo --project ./tsconfig.json",
    "cf-typegen": "wrangler types",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/cloudflare-sandbox-bridge --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "wrangler": "^4.151.0"
  }
}
