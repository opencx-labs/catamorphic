{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catamorphic-sandbox-bridge-native",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": {
    "enabled": true
  },
  // This replacement Worker owns a new class and namespace. Never attach
  // native scheduling to a legacy Sandbox namespace or mutate the old Worker.
  "containers": [
    {
      "class_name": "NativeSandbox",
      "name": "catamorphic-sandbox-bridge-native",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "NativeSandbox",
        "name": "NativeSandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["NativeSandbox"],
      "tag": "v1"
    }
  ],
  "env": {
    "dev": {
      "name": "catamorphic-sandbox-bridge-dev-native",
      "containers": [
        {
          "class_name": "NativeSandbox",
          "name": "catamorphic-sandbox-bridge-dev-native",
          "scheduling_policy": "durable_object",
          "images": { "sandbox": { "dockerfile": "./Dockerfile" } }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "class_name": "NativeSandbox",
            "name": "NativeSandbox"
          }
        ]
      }
    }
  },
  "preview_urls": false
}
