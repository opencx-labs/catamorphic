{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catamorphic-sandbox-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // The Sandbox Durable Object + its container image.
  // Bump the migration tag whenever new_sqlite_classes changes.
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // "lite" is a good default; upgrade to "standard-1" (4 vCPU / 8 GiB RAM)
      // if workloads outgrow it. Kept as a single global instance_type — see
      // CLOUDFLARE.md for the reasoning behind not making this per-project.
      "instance_type": "lite",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "WarmPool",
        "name": "WarmPool"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["WarmPool"],
      "tag": "v2"
    }
  ],
  // Warm pool is disabled by default (no surprise bills). Set WARM_POOL_TARGET
  // > 0 and enable the cron below to pre-warm containers.
  "vars": {
    "WARM_POOL_TARGET": "0",
    "WARM_POOL_REFRESH_INTERVAL": "10000"
  },
  "preview_urls": false
}
