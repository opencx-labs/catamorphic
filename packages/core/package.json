{
  "name": "@catamorphic/core",
  "version": "0.1.0-alpha.38",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/core --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts"
    ]
  },
  "dependencies": {
    "@catamorphic/agent-protocol": "workspace:*",
    "@catamorphic/agent-runner": "workspace:*",
    "@catamorphic/app": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/otel": "workspace:*",
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/plugins": "workspace:*",
    "@catamorphic/runner-bundle": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@catamorphic/workflow": "workspace:*",
    "croner": "^11.0.0",
    "kysely": "^0.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@catamorphic/cloudflare": "workspace:*",
    "@catamorphic/local-process": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@opentelemetry/api": "^1.10.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/context-async-hooks": "^3.1.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
