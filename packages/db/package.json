{
  "name": "@catamorphic/db",
  "version": "0.1.0-alpha.30",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "catamorphic-db": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**",
    "migrations"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./migrations": "./migrations",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/db --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json",
    "db:migrate": "bun run src/cli.ts migrate",
    "db:status": "bun run src/cli.ts status",
    "db:codegen": "kysely-codegen --out-file src/generated/db.ts --include-pattern 'catamorphic.*' --default-schema=catamorphic",
    "db:reset": "bun run src/cli.ts reset"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/cli.ts"
    ],
    "splitting": false
  },
  "dependencies": {
    "kysely": "^0.29.3",
    "pg": "^8.22.0",
    "@types/pg": "^8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "kysely-codegen": "^0.20.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/db"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
