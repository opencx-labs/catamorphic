{
  "name": "@catamorphic/fastify-plugin",
  "version": "0.1.0-alpha.38",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/fastify-plugin --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json",
    "generate-spec": "bun run scripts/generate-spec.ts && biome format --write ../api-client/openapi.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/mcp.ts"
    ]
  },
  "dependencies": {
    "@catamorphic/app": "workspace:*",
    "@catamorphic/core": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/plugins": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.8",
    "zod": "^4.6.7",
    "@catamorphic/otel": "workspace:*",
    "@catamorphic/workflow": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@catamorphic/agent-protocol": "workspace:*"
  },
  "devDependencies": {
    "@catamorphic/agent-runner": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/fastify-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
