{
  "name": "@catamorphic/fastify-plugin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json",
    "generate-spec": "bun run scripts/generate-spec.ts && biome format --write ../api-client/openapi.json"
  },
  "dependencies": {
    "@catamorphic/app": "workspace:*",
    "@catamorphic/core": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/github": "workspace:*",
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/plugins": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.3",
    "zod": "^4.4.3"
  }
}
