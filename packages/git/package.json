{
  "name": "@catamorphic/git",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/git --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts"
    ]
  },
  "dependencies": {
    "@catamorphic/workflow": "workspace:*",
    "diff3": "0.0.3",
    "ignore": "^5.3.2",
    "isomorphic-git": "^1.38.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
