{
  "name": "@catamorphic/otel",
  "version": "0.1.0-alpha.38",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "bun": "./src/node.ts",
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/otel --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/node.ts"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.301.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/resources": "^3.1.1",
