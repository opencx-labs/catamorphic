{
  "name": "@catamorphic/otel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "bun": "./src/node.ts",
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/otel --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0"
  },
