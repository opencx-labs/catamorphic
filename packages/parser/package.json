{
  "name": "@catamorphic/parser",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./layout": {
      "import": "./dist/layout-entry.js",
      "types": "./dist/layout-entry.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/parser --config ../../vitest.config.ts",
    "test:watch": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/parser --watch",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/layout-entry.ts"
    ]
  },
  "dependencies": {
    "@catamorphic/workflow": "workspace:*",
    "dagre": "^0.8.5",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
