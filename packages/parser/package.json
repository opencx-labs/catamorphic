{
  "name": "@catamorphic/parser",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./layout": {
      "bun": "./src/layout-entry.ts",
      "import": "./dist/layout.js",
      "types": "./dist/layout.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/parser --config ../../vitest.config.ts",
    "test:watch": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/parser --watch",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "dagre": "^0.8.5",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
