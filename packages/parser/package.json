{
  "name": "@catamorphic/parser",
  "version": "0.1.0-alpha.30",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./layout": {
      "import": "./dist/layout-entry.js",
      "types": "./dist/layout-entry.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/parser --config ../../vitest.config.ts",
    "test:watch": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/parser --watch",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/layout-entry.ts"
    ],
    "splitting": false
  },
  "dependencies": {
    "@catamorphic/workflow": "workspace:*",
    "dagre": "^0.8.5",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/parser"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
