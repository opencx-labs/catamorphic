    "shiki": "^4.6.0",
    "@shikijs/langs": "^4.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^18.2 || ^19",
    "react-dom": "^18.2 || ^19"
  },
  "devDependencies": {
    "@catamorphic/agent-protocol": "workspace:*",
    "@catamorphic/api-client": "workspace:*",
    "@catamorphic/core": "workspace:*",
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/server-sdk": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
