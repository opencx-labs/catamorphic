{
  "version": 1,
  "name": "Reviewer",
  "kind": "builtin",
  "description": "Reviews pull requests for correctness, security, data safety, performance, and tests, verifying by running them.",
  "sandboxing": "contained",
  "environment": {
    "preferred": ["review"],
    "allowed": ["review"]
  },
  "stall": { "minutes": 20 },
  "connections": [
    {
      "alias": "github",
      "principal": "service"
    },
    {
      "alias": "git",
      "principal": "service"
    },
    {
      "alias": "prod",
      "principal": "service",
      "optional": true
    },
    {
      "alias": "slack",
      "principal": "service",
      "optional": true
    }
  ],
  "toolPolicies": {
    "github": {
      "default": "deny",
      "tools": {
        "get": "allow",
        "pull_request_files": "allow",
        "review_threads": "allow"
      }
    }
  },
  "results": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedCommit",
        "verdict",
        "score",
        "summary",
        "checkSummary"
      ],
      "properties": {
        "reviewedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The commit your workspace stood on when you reviewed"
        },
        "verdict": {
          "enum": ["COMMENT", "REQUEST_CHANGES"]
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "summary": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 4000
        },
        "checkSummary": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 4000
        },
        "findings": {
          "type": ["array", "null"],
          "maxItems": 30,
          "uniqueItems": true,
          "description": "The ids of this turn's finding results the review stands behind",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          }
        },
        "reply": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["body"],
          "properties": {
            "inReplyTo": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "body": {
              "type": "string",
              "pattern": "\\S",
              "maxLength": 4000
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "line", "severity", "title", "body"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "description": "Names this problem: the same id on the same head never posts twice"
        },
        "path": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 300
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "The line in the new file, or the old one when side is LEFT; the last line of a range"
        },
        "startLine": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "The first line of a range ending at line"
        },
        "side": {
          "enum": ["LEFT", "RIGHT", null]
        },
        "severity": {
          "enum": ["blocking", "important", "minor"]
        },
        "title": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 1500
        }
      }
    }
  }
}
