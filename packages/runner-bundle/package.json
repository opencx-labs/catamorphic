{
  "name": "@catamorphic/runner-bundle",
  "version": "0.1.0-alpha.32",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly && bun scripts/build-bundle.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts"
    ]
  },
  "dependencies": {
    "@catamorphic/acp": "workspace:*",
    "@catamorphic/agent-protocol": "workspace:*",
    "@catamorphic/agent-runner": "workspace:*",
    "@catamorphic/claude-code": "workspace:*",
    "@catamorphic/codex": "workspace:*",
    "@catamorphic/sandbox": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/runner-bundle"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
