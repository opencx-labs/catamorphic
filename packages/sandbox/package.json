{
  "name": "@catamorphic/sandbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./attachments": {
      "bun": "./src/coding-agent/text-attachments.ts",
      "import": "./dist/attachments.js",
      "types": "./dist/coding-agent/text-attachments.d.ts"
    },
    "./testing": {
      "development": "./src/coding-agent/runtime-conformance.ts",
      "bun": "./src/coding-agent/runtime-conformance.ts",
      "import": "./dist/testing.js",
      "types": "./dist/coding-agent/runtime-conformance.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "@catamorphic/otel": "workspace:*",
    "@catamorphic/runtime": "workspace:*",
    "@catamorphic/workflow": "workspace:*",
    "@catamorphic/app": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
