{
  "name": "@catamorphic/sandbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./attachments": {
      "bun": "./src/coding-agent/text-attachments.ts",
      "import": "./dist/coding-agent/text-attachments.js",
      "types": "./dist/coding-agent/text-attachments.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/sandbox --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/coding-agent/text-attachments.ts"
    ],
    "external": [
      "@catamorphic/sandbox"
    ],
    "splitting": false
  },
  "dependencies": {
    "@catamorphic/otel": "workspace:*",
    "@catamorphic/runtime": "workspace:*",
    "@catamorphic/workflow": "workspace:*",
    "@catamorphic/app": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
