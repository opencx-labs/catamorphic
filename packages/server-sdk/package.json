{
  "name": "@catamorphic/server-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./web-push": {
      "bun": "./src/web-push.ts",
      "import": "./dist/web-push.js",
      "types": "./dist/web-push.d.ts"
    },
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/server-sdk --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "@catamorphic/core": "workspace:*",
    "@catamorphic/otel": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/github": "workspace:*",
    "@catamorphic/plugins": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "croner": "^10.0.1",
    "kysely": "^0.29.3",
    "pg": "^8.22.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@electric-sql/pglite": "^0.5.4",
    "@catamorphic/fastify-plugin": "workspace:*"
  }
}
