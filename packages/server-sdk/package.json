{
  "name": "@catamorphic/server-sdk",
  "version": "0.1.0-alpha.31",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./web-push": {
      "bun": "./src/web-push.ts",
      "import": "./dist/web-push.js",
      "types": "./dist/web-push.d.ts"
    },
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/server-sdk --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/web-push.ts"
    ]
  },
  "dependencies": {
    "@catamorphic/core": "workspace:*",
    "@catamorphic/otel": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/git": "workspace:*",
    "@catamorphic/github": "workspace:*",
    "@catamorphic/plugins": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "croner": "^10.0.1",
    "kysely": "^0.29.3",
    "pg": "^8.22.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "@types/pg": "^8.20.0",
    "@catamorphic/app": "workspace:*"
  },
  "devDependencies": {
    "@catamorphic/agent-runner": "workspace:*",
    "@catamorphic/fastify-plugin": "workspace:*",
    "@catamorphic/parser": "workspace:*",
    "@electric-sql/pglite": "^0.5.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@types/node": "^26.1.1",
    "@types/web-push": "^3.6.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/server-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
