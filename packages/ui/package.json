{
  "name": "@catamorphic/ui",
  "version": "0.1.0-alpha.32",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/ui --config ./vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts"
    ],
    "external": [
      "react",
      "react-dom"
    ]
  },
  "dependencies": {
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/react": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "jotai": "^2.20.1",
    "lucide-react": "^1.24.0",
    "use-stick-to-bottom": "^1.1.6",
    "@catamorphic/app": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18.2 || ^19",
    "react-dom": "^18.2 || ^19"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
