{
  "name": "@catamorphic/ui",
  "version": "0.1.0-alpha.38",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/ui --config ./vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts"
    ],
    "external": [
      "react",
      "react-dom"
    ]
  },
  "dependencies": {
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/react": "workspace:*",
    "@xyflow/react": "^12.12.1",
    "jotai": "^3.0.2",
    "lucide-react": "^1.72.0",
    "use-stick-to-bottom": "^1.1.6",
    "@catamorphic/app": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^18.2 || ^19",
    "react-dom": "^18.2 || ^19"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
