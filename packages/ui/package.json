{
  "name": "@catamorphic/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/ui --config ./vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json"
  },
  "dependencies": {
    "@catamorphic/parser": "workspace:*",
    "@catamorphic/react": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "jotai": "^2.20.1",
    "lucide-react": "^1.24.0",
    "use-stick-to-bottom": "^1.1.6",
    "@catamorphic/app": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18.2 || ^19",
    "react-dom": "^18.2 || ^19"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vitest": "^4.1.11"
  }
}
