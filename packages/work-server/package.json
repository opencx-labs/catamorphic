{
  "name": "@catamorphic/work-server",
  "version": "0.1.0-alpha.38",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "typecheck": "bun check --project ./tsconfig.json",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/work-server --config ../../vitest.config.ts --pool=forks"
  },
  "bundle": {
    "entry": [
      "src/index.ts"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/openai": "^4.0.115",
    "@better-auth/mcp": "1.7.21",
    "@better-auth/oauth-provider": "1.7.21",
    "@catamorphic/agent-protocol": "workspace:*",
    "@catamorphic/agent-runner": "workspace:*",
    "@catamorphic/ai-sdk": "workspace:*",
    "@catamorphic/app": "workspace:*",
    "@catamorphic/container": "workspace:*",
    "@catamorphic/core": "workspace:*",
    "@catamorphic/db": "workspace:*",
    "@catamorphic/fastify-plugin": "workspace:*",
    "@catamorphic/hetzner": "workspace:*",
    "@catamorphic/local-process": "workspace:*",
    "@catamorphic/mcp": "workspace:*",
    "@catamorphic/microsandbox": "workspace:*",
    "@catamorphic/otel": "workspace:*",
    "@catamorphic/registry": "workspace:*",
    "@catamorphic/sandbox": "workspace:*",
    "@catamorphic/server-sdk": "workspace:*",
    "@catamorphic/workflow": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@openai/codex": "0.167.1",
    "better-auth": "1.7.21",
    "fastify": "^5.12.8",
    "kysely": "^0.29.8",
    "micromark": "^4.0.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencx-labs/catamorphic.git",
    "directory": "packages/work-server"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.txt",
    "NOTICE.txt",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/**",
    "!**/__fixtures__/**",
    "!**/fixtures/**"
  ]
}
