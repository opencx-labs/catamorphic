{
  "name": "@catamorphic/workflow",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "tsup --watch --no-clean",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts",
    "typecheck": "tsgo --project ./tsconfig.json && tsgo --project ./tsconfig.type-tests.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
