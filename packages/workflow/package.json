{
  "name": "@catamorphic/workflow",
  "version": "0.0.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./project-layout": {
      "import": "./dist/project-layout.js",
      "types": "./dist/project-layout.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && tsc --project tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "bun ../../scripts/build-package.ts --watch",
    "test": "bun ../../scripts/tool-runtime.ts vitest --tool-cwd packages/workflow --config ../../vitest.config.ts",
    "typecheck": "bun check --project ./tsconfig.json && bun check --project ./tsconfig.type-tests.json"
  },
  "bundle": {
    "entry": [
      "src/index.ts",
      "src/project-layout.ts"
    ],
    "splitting": false
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
