{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@catamorphic/registry#build": {
      "outputs": ["dist/**"]
    },
    "catamorphic-desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "@catamorphic/api-client#build": {
      "inputs": ["$TURBO_DEFAULT$", "src/schema.d.ts"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "BETTER_AUTH_SECRET",
        "CATAMORPHIC_AUTH_CONFIG",
        "CATAMORPHIC_DATA_DIR",
        "CATAMORPHIC_DESKTOP_CDP_PORT",
        "CATAMORPHIC_DESKTOP_DATA_DIR",
        "CATAMORPHIC_DESKTOP_PREVIOUS_DATA_DIR",
        "CATAMORPHIC_DESKTOP_VITE_PORT",
        "CATAMORPHIC_DEV_INSTANCE",
        "CATAMORPHIC_E2E_FAKE_AGENT",
        "CATAMORPHIC_EFFORT",
        "CATAMORPHIC_FAKE_AGENT",
        "CATAMORPHIC_GITHUB_APP_SLUG",
        "CATAMORPHIC_GITHUB_CLIENT_ID",
        "CATAMORPHIC_MDNS",
        "CATAMORPHIC_MODEL",
        "CATAMORPHIC_OPERATOR_PORT",
        "CATAMORPHIC_OPERATOR_SECRET",
        "CATAMORPHIC_PUBLIC_URL",
        "CATAMORPHIC_PWA_DIST",
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "PORT"
      ]
    },
    "dev:bundle": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "catamorphic-desktop#dev": {
      "dependsOn": ["^build", "catamorphic-pwa#build"],
      "with": ["catamorphic-pwa#dev:bundle"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "BETTER_AUTH_SECRET",
        "CATAMORPHIC_AUTH_CONFIG",
        "CATAMORPHIC_DATA_DIR",
        "CATAMORPHIC_DESKTOP_CDP_PORT",
        "CATAMORPHIC_DESKTOP_DATA_DIR",
        "CATAMORPHIC_DESKTOP_PREVIOUS_DATA_DIR",
        "CATAMORPHIC_DESKTOP_VITE_PORT",
        "CATAMORPHIC_DEV_INSTANCE",
        "CATAMORPHIC_E2E_FAKE_AGENT",
        "CATAMORPHIC_EFFORT",
        "CATAMORPHIC_FAKE_AGENT",
        "CATAMORPHIC_GITHUB_APP_SLUG",
        "CATAMORPHIC_GITHUB_CLIENT_ID",
        "CATAMORPHIC_MDNS",
        "CATAMORPHIC_MODEL",
        "CATAMORPHIC_OPERATOR_PORT",
        "CATAMORPHIC_OPERATOR_SECRET",
        "CATAMORPHIC_PUBLIC_URL",
        "CATAMORPHIC_PWA_DIST",
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "PORT"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "env": [
        "CATAMORPHIC_DB_SCHEMA",
        "CATAMORPHIC_E2E_FAKE_AGENT",
        "CATAMORPHIC_EXTERNAL_INTEGRATIONS",
        "CF_SANDBOX_INTEGRATION",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ARTIFACTS_NAMESPACE",
        "CLOUDFLARE_SANDBOX_API_KEY",
        "CLOUDFLARE_SANDBOX_API_URL",
        "DAYTONA_API_KEY",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_FORCE_PATH_STYLE",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY",
        "CI",
        "CATAMORPHIC_TEST_SHARD"
      ],
      "cache": true,
      "outputs": [],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "catamorphic-desktop#test:e2e:ci": {
      "outputs": [],
      "env": [
        "CI",
        "GITHUB_ACTIONS",
        "RUNNER_ENVIRONMENT",
        "CATAMORPHIC_TEST_SHARD",
        "CHROME_BIN"
      ],
      "cache": true,
      "dependsOn": ["build", "catamorphic-pwa#build"]
    },
    "catamorphic-pwa#test:e2e:ci": {
      "outputs": [],
      "env": [
        "CI",
        "GITHUB_ACTIONS",
        "RUNNER_ENVIRONMENT",
        "CATAMORPHIC_TEST_SHARD",
        "CHROME_BIN"
      ],
      "cache": true,
      "dependsOn": ["build", "catamorphic-server#build"]
    }
  },
  "globalPassThroughEnv": [
    "CATAMORPHIC_E2E_ARTIFACTS_DIR",
    "CATAMORPHIC_REUSE_TESTS"
  ],
  "globalDependencies": [
    "scripts/**",
    "vitest.config.ts",
    "tsconfig*.json",
    ".github/actions/**",
    ".github/workflows/ci.yml",
    "infra/desktop-tests/**"
  ],
  "globalEnv": ["CATAMORPHIC_TEST_RUNTIME"]
}
