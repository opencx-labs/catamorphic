{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@catamorphic/registry#build": {
      "outputs": ["dist/**"]
    },
    "@catamorphic/api-client#build": {
      "inputs": ["$TURBO_DEFAULT$", "src/schema.d.ts"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:bundle": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "catamorphic-desktop#dev": {
      "dependsOn": ["^build", "catamorphic-pwa#build"],
      "with": ["catamorphic-pwa#dev:bundle"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CATAMORPHIC_DB_SCHEMA",
        "CATAMORPHIC_E2E_FAKE_AGENT",
        "CF_SANDBOX_INTEGRATION",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ARTIFACTS_NAMESPACE",
        "CLOUDFLARE_SANDBOX_API_KEY",
        "CLOUDFLARE_SANDBOX_API_URL",
        "DATABASE_URL",
        "DAYTONA_API_KEY",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_FORCE_PATH_STYLE",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
